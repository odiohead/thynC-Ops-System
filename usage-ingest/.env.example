# thynC 사용량 수신부 설정 (본체 .env 와 별개 — 본체 DB 접속 정보를 넣지 않는다)
# 복사해서 usage-ingest/.env 로 쓴다.

# 원본 DB (본체 DB 와 다른 DB, 전용 계정)
USAGE_DATABASE_URL=postgresql://thync_usage:<비밀번호>@localhost:5432/thync_usage_dev

# 수신부가 듣는 포트 (127.0.0.1 에만 묶인다 — 밖에서는 Nginx 의 /api/usage-ingest/ 로 들어온다)
USAGE_INGEST_PORT=3110

# 용량 안전장치: 원본 DB 가 이 크기(bytes)를 넘으면 기기 상태 이력 수신을 멈춘다. 0 = 상한 없음
# dev 는 PROD 와 같은 디스크를 쓰므로 낮게 잡는다 (2GB)
USAGE_MAX_BYTES=2147483648
