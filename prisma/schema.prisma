  emrVendorId  Int?        @map("emr_vendor_id")
  dataScopes   String[]    @default([]) @map("data_scopes") // 환자정보조회 / 일일레포트 / 이벤트 심전도 / 생체신호 (복수)
  linkMethods  String[]    @default([]) @map("link_methods") // API / HL7(TCP/IP) / SFTP (복수)
