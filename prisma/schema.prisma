generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "wiki"]
}

model HiraHospital {
  id             Int       @id @default(autoincrement())
  hiraId         String    @unique @map("hira_id")
  name           String    @map("name")
  typeCode       String    @map("type_code")
  typeName       String    @map("type_name")
  sidoCode       String    @map("sido_code")
  sidoName       String    @map("sido_name")
  sigunguCode    String    @map("sigungu_code")
  sigunguName    String    @map("sigungu_name")
  eupmyeondong   String?   @map("eupmyeondong")
  postalCode     String?   @map("postal_code")
  address        String?   @map("address")
  phone          String?   @map("phone")
  homepage       String?   @map("homepage")
  totalDoctors   Int?      @map("total_doctors")
  openedAt       String?   @map("opened_at")
  coordinateX    String?   @map("coordinate_x")
  coordinateY    String?   @map("coordinate_y")
  mdeptGdrCnt    Int?      @map("mdept_gdr_cnt")
  mdeptIntnCnt   Int?      @map("mdept_intn_cnt")
  mdeptResdntCnt Int?      @map("mdept_resdnt_cnt")
  mdeptSdrCnt    Int?      @map("mdept_sdr_cnt")
  detyGdrCnt     Int?      @map("dety_gdr_cnt")
  detyIntnCnt    Int?      @map("dety_intn_cnt")
  detyResdntCnt  Int?      @map("dety_resdnt_cnt")
  detySdrCnt     Int?      @map("dety_sdr_cnt")
  cmdcGdrCnt     Int?      @map("cmdc_gdr_cnt")
  cmdcIntnCnt    Int?      @map("cmdc_intn_cnt")
  cmdcResdntCnt  Int?      @map("cmdc_resdnt_cnt")
  cmdcSdrCnt     Int?      @map("cmdc_sdr_cnt")
  midwifeCnt     Int?      @map("midwife_cnt")
  permSbdCnt     Int?      @map("perm_sbd_cnt")
  detailSyncedAt DateTime? @map("detail_synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  hospital       Hospital?

  @@map("hira_hospitals")
  @@schema("public")
}

model Hospital {
  id                    Int                          @id @default(autoincrement())
  hospitalCode          String                       @unique @map("hospital_code")
  hiraId                String?                      @unique @map("hira_id")
  hiraHospitalName      String                       @map("hira_hospital_name")
  hospitalName          String                       @map("hospital_name")
  type                  String                       @map("type")
  sidoCode              String?                      @map("sido_code")
  sidoName              String?                      @map("sido_name")
  sigunguCode           String?                      @map("sigungu_code")
  sigunguName           String?                      @map("sigungu_name")
  eupmyeondong          String?                      @map("eupmyeondong")
  postalCode            String?                      @map("postal_code")
  address               String?                      @map("address")
  coordinateX           String?                      @map("coordinate_x")
  coordinateY           String?                      @map("coordinate_y")
  status                String                       @map("status")
  introType             String?                      @map("intro_type")
  introBeds             Int?                         @map("intro_beds")
  contractDate          DateTime?                    @map("contract_date")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")
  hiraHospital          HiraHospital?                @relation(fields: [hiraId], references: [hiraId])
  daewoongAssignments   DaewoongHospitalAssignment[]
  servers               HospitalServer[]
  emrInfo               HospitalEmrInfo?
  vocReceipts           VocReceipt[]
  projects              Project[]
  meta                  HospitalMeta?
  hospitalDevices       HospitalDevice[]             @relation("DeviceCurrentHospital") // 현재 배치 중 개체 (원장, 2026-09-01)
  lastHospitalDevices   HospitalDevice[]             @relation("DeviceLastHospital")    // 이 병원에서 회수된(미재배치) 개체
  hospitalWards         HospitalWard[]
  deviceEvents          HospitalDeviceEvent[]
  deviceImportBatches   HospitalDeviceImportBatch[]
  siteVisits            SiteVisit[]
  introTypes            HospitalIntroType[]
  installPlans          InstallPlan[]
  maintenances          Maintenance[]
  consultationQueues    ConsultationQueue[]
  consultations         Consultation[]
  tasks                 Task[]
  etcTaskHospitals      EtcTaskHospital[]
  inventoryTransactions InventoryTransaction[]
  inventoryUnits        InventoryUnit[]
  aiChatSessions        AiChatSession[]
  aiUsageLogs           AiUsageLog[]
  tickets               Ticket[]
  salesProfile          HospitalSalesProfile?
  personAffiliations    PersonAffiliation[]
  salesDeals            SalesDeal[]
  salesActivities       SalesActivity[]
  weeklyItems           WeeklyItem[]

  @@map("hospitals")
  @@schema("public")
}

model HospitalIntroType {
  id           Int        @id @default(autoincrement())
  hospitalId   Int        @map("hospital_id")
  statusCodeId Int        @map("status_code_id")
  hospital     Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  statusCode   StatusCode @relation(fields: [statusCodeId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, statusCodeId])
  @@map("hospital_intro_types")
  @@schema("public")
}

model DaewoongHospitalAssignment {
  id             String   @id @default(uuid())
  hospitalCode   String   @map("hospital_code")
  assignedUserId String   @map("assigned_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  hospital       Hospital @relation(fields: [hospitalCode], references: [hospitalCode])
  assignedUser   User     @relation(fields: [assignedUserId], references: [id])

  @@unique([hospitalCode, assignedUserId])
  @@map("daewoong_hospital_assignments")
  @@schema("public")
}

model StatusCode {
  id                     Int                    @id @default(autoincrement())
  name                   String                 @map("name")
  value                  String?                @map("value")
  order                  Int                    @default(0) @map("order")
  color                  String?                @map("color")
  category               String                 @default("HOSPITAL") @map("category")
  // 도메인↔티켓 상태 매핑 (ticket_status_map_design.md — 워크플로 카테고리만 사용, ASSIGNED는 owner 유무로 엔진 판정)
  ticketStatus           TicketStatus?          @map("ticket_status")
  ticketPendingReasonId  Int?                   @map("ticket_pending_reason_id")
  ticketPendingReason    TicketPendingReason?   @relation("StatusCodePendingReason", fields: [ticketPendingReasonId], references: [id], onDelete: SetNull)
  createdAt              DateTime               @default(now()) @map("created_at")
  siteVisits             SiteVisit[]
  hospitalIntroTypes     HospitalIntroType[]
  introTypeProjects      Project[]              @relation("ProjectIntroType")
  consultationTypeQueues ConsultationQueue[]    @relation("ConsultationTypeQueue")
  documentTypeQueues     ConsultationQueue[]    @relation("DocumentTypeQueue")
  consultationTypes      Consultation[]         @relation("ConsultationType")
  documentTypes          Consultation[]         @relation("ConsultationDocumentType")
  maintenanceTypes       Maintenance[]          @relation("MaintenanceType")
  maintenanceStatuses    Maintenance[]          @relation("MaintenanceStatus")
  etcTaskStatuses        EtcTask[]              @relation("EtcTaskStatus")
  installPlanStatuses    InstallPlan[]          @relation("InstallPlanStatus")
  manufacturerItems      InventoryItem[]        @relation("ItemManufacturer")
  reasonTransactions     InventoryTransaction[] @relation("TxReason")
  ctiRuleMatches         TicketDomainCtiRule[]  @relation("CtiRuleMatchStatus")
  salesStageProfiles     HospitalSalesProfile[] @relation("SalesProfileStage")
  dealStatuses           SalesDeal[]            @relation("DealStatus")
  dealHospitalModels     SalesDeal[]            @relation("DealHospitalModel")
  dealSeersModels        SalesDeal[]            @relation("DealSeersModel")
  dealTaxInvoices        SalesDeal[]            @relation("DealTaxInvoice")
  dealSettlements        SalesDeal[]            @relation("DealSettlement")
  salesActivityTypes     SalesActivity[]        @relation("SalesActivityType")
  persons                Person[]               @relation("PersonGroup")
  emrVendorInfos         HospitalEmrInfo[]      @relation("EmrVendor")
  vocChannels            VocReceipt[]           @relation("VocChannel")
  vocTypes               VocReceipt[]           @relation("VocType")
  vocStatuses            VocReceipt[]           @relation("VocStatus")
  deviceRecoverReasons   HospitalDevice[]       @relation("DeviceRecoverReason") // DEVICE_RECOVERY_REASON (원장 프로젝션)
  deviceEventReasons     HospitalDeviceEvent[]  @relation("DeviceEventReason")   // DEVICE_RECOVERY_REASON (RECOVER 이벤트)

  @@unique([name, category])
  @@map("status_codes")
  @@schema("public")
}

model ConsultationQueue {
  id                 Int      @id @default(autoincrement())
  hospitalCode       String?  @map("hospital_code")
  consultationTypeId Int?     @map("consultation_type_id")
  documentTypeId     Int?     @map("document_type_id")
  conclusion         String?
  chatHistory        Json     @default("[]") @map("chat_history")
  aiSummary          String?  @map("ai_summary")
  status             String   @default("PENDING")
  consultedById      String   @map("consulted_by_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @map("updated_at")

  hospital         Hospital?   @relation(fields: [hospitalCode], references: [hospitalCode])
  consultationType StatusCode? @relation("ConsultationTypeQueue", fields: [consultationTypeId], references: [id])
  documentType     StatusCode? @relation("DocumentTypeQueue", fields: [documentTypeId], references: [id])
  consultedBy      User        @relation(fields: [consultedById], references: [id])

  @@map("consultation_queue")
  @@schema("public")
}

/// 상담이력 — AI 어시스턴트 상담 정리 결과의 **원본**.
/// 구 방식(위키 '병원 노트' 마크다운 append)을 2026-07-26에 대체했다.
/// 상담이력은 문서가 아니라 운영 이벤트(v3 축2)이므로 DB가 원본이고,
/// 위키 병원 노트는 '사람이 쓰는 병원 메모'로 역할이 분리되었다.
/// 설계: consultation_history_design.md
model Consultation {
  id                 Int      @id @default(autoincrement())
  consultationCode   String   @unique @map("consultation_code") @db.VarChar(20)
  hospitalCode       String   @map("hospital_code")
  consultationTypeId Int?     @map("consultation_type_id")
  documentTypeId     Int?     @map("document_type_id")
  title              String   @db.VarChar(200)
  content            String
  aiSummary          String?  @map("ai_summary")
  /// AiChatSession id — FK를 걸지 않는다. 대화를 삭제해도 상담이력은 보존(ai_usage_logs 선례)
  sessionId          String?  @map("session_id")
  consultedById      String   @map("consulted_by_id")
  /// 계정 삭제 후에도 목록에 표시하기 위한 스냅샷
  consultedByName    String   @map("consulted_by_name") @db.VarChar(100)
  consultedAt        DateTime @map("consulted_at") @db.Date
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  hospital         Hospital    @relation(fields: [hospitalCode], references: [hospitalCode])
  consultationType StatusCode? @relation("ConsultationType", fields: [consultationTypeId], references: [id])
  documentType     StatusCode? @relation("ConsultationDocumentType", fields: [documentTypeId], references: [id])
  consultedBy      User        @relation(fields: [consultedById], references: [id])

  @@index([hospitalCode, consultedAt(sort: Desc)])
  @@index([consultedById, consultedAt(sort: Desc)])
  @@index([consultedAt(sort: Desc)])
  @@map("consultations")
  @@schema("public")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  VIEWER

  @@schema("public")
}

model Organization {
  id          Int          @id @default(autoincrement())
  name        String
  code        String       @unique
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  users       User[]
  departments Department[]

  @@map("organizations")
  @@schema("public")
}

model User {
  id                        String                       @id @default(uuid())
  email                     String                       @unique
  password                  String
  name                      String
  phone                     String
  role                      Role                         @default(USER)
  isActive                  Boolean                      @default(true) @map("is_active")
  vehicleReservationBlocked Boolean                      @default(false) @map("vehicle_reservation_blocked")
  organizationId            Int?                         @map("organization_id")
  departmentId              Int?                         @map("department_id")
  slackUserId               String?                      @map("slack_user_id") @db.VarChar(20) // Slack DM 매핑 캐시 (Phase 4)
  notifications             Notification[]               @relation("NotificationRecipient")
  notificationsActed        Notification[]               @relation("NotificationActor")
  notificationPrefs         NotificationPref[]
  slackNotifyEnabled        Boolean                      @default(true) @map("slack_notify_enabled") // 계정별 Slack 발송 유무(false=미발송)
  createdAt                 DateTime                     @default(now()) @map("created_at")
  lastLoginAt               DateTime?                    @map("last_login_at")
  organization              Organization?                @relation(fields: [organizationId], references: [id])
  department                Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  fieldEngineers            FieldEngineer[]
  daewoongSiteVisits        SiteVisit[]                  @relation("SiteVisitDaewoongUser")
  hospitalAssignments       DaewoongHospitalAssignment[]
  projectAssignees          ProjectAssignee[]
  installPlanAssignees      InstallPlanAssignee[]
  siteVisitAssignees        SiteVisitAssignee[]
  maintenanceAssignees      MaintenanceAssignee[]
  maintenanceLogs           MaintenanceLog[]             @relation("MaintenanceLogAuthor")
  etcTaskAssignees          EtcTaskAssignee[]
  consultationQueues        ConsultationQueue[]
  consultations             Consultation[]
  wikiPagesAuthored         WikiPage[]                   @relation("WikiPageAuthor")
  wikiPagesEdited           WikiPage[]                   @relation("WikiPageLastEditor")
  wikiAttachmentsUploaded   WikiAttachment[]             @relation("WikiAttachmentUploader")
  wikiPageRefsCreated       WikiPageReference[]          @relation("WikiPageRefCreator")
  wikiFavorites             WikiFavorite[]               @relation("WikiFavoriteUser")
  wikiViewLogs              WikiViewLog[]                @relation("WikiViewLogUser")
  wikiVersionsSaved         WikiVersion[]                @relation("WikiVersionSaver")
  wikiCommentsAuthored      WikiComment[]                @relation("WikiCommentAuthor")
  vehicleReservations       VehicleReservation[]         @relation("VehicleReservationUser")
  vehicleLogsDriven         VehicleLog[]                 @relation("VehicleLogDriver")
  vehicleLogsCreated        VehicleLog[]                 @relation("VehicleLogCreator")
  inventoryManager          InventoryManager?
  inventoryTxActed          InventoryTransaction[]       @relation("InventoryTxActor")
  inventoryTxCanceled       InventoryTransaction[]       @relation("InventoryTxCanceler")
  udiLedgerChecks           UdiLedgerCheck[]             @relation("UdiLedgerChecker")
  appRoles                  AppUserRole[]
  aiChatSessions            AiChatSession[]
  aiUsageLogs               AiUsageLog[]
  aiFeedbacks               AiFeedback[]
  gatewayPlanJobs           GatewayPlanJob[]             @relation("GatewayPlanJobCreator")
  ownedTickets              Ticket[]                     @relation("TicketOwner")
  createdTickets            Ticket[]                     @relation("TicketCreator")
  ticketParticipations      TicketParticipant[]          @relation("TicketParticipantUser")
  ticketLogs                TicketLog[]                  @relation("TicketLogAuthor")
  ticketQueueMemberships    TicketQueueMember[]          @relation("TicketQueueMemberUser")
  ticketCtiRuleUpdates      TicketDomainCtiRule[]        @relation("CtiRuleUpdater")
  vocReceiptsCreated        VocReceipt[]                 @relation("VocCreator")
  salesActivities           SalesActivity[]              @relation("SalesActivityAuthor")
  salesOwnedProfiles        HospitalSalesProfile[]       @relation("SalesProfileOwner")
  weeklyItemsOwned          WeeklyItem[]                 @relation("WeeklyItemOwner")
  weeklyItemsCreated        WeeklyItem[]                 @relation("WeeklyItemCreator")
  weeklyUpdatesEdited       WeeklyItemUpdate[]           @relation("WeeklyUpdateEditor")
  weeklyNotesEdited         WeeklyWeekNote[]             @relation("WeeklyNoteEditor")
  weeklyNotesAuthored       WeeklyWeekNote[]             @relation("WeeklyNoteAuthor")
  deviceImportsCreated      HospitalDeviceImportBatch[]  @relation("DeviceImportCreatedBy")
  deviceImportsCancelled    HospitalDeviceImportBatch[]  @relation("DeviceImportCancelledBy")
  deviceEventsActed         HospitalDeviceEvent[]        @relation("DeviceEventActor")
  deviceEventsEdited        HospitalDeviceEvent[]        @relation("DeviceEventEditor")

  @@map("users")
  @@schema("public")
}

model Department {
  id             Int          @id @default(autoincrement())
  name           String       @db.VarChar(100)
  organizationId Int          @map("organization_id")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  weeklyItems    WeeklyItem[]

  @@map("departments")
  @@schema("public")
}

model FieldEngineer {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  workType  String   @default("PROJECT") @map("work_type")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workType])
  @@index([workType])
  @@map("field_engineers")
  @@schema("public")
}

model DeviceInfo {
  id              Int              @id @default(autoincrement())
  deviceModel     String           @unique @map("device_model")
  deviceName      String           @map("device_name")
  isActive        Boolean          @default(true) @map("is_active")
  sortOrder       Int              @default(0) @map("sort_order")
  // 디바이스 원장 확장 5필드 (hospital_device_registry_design.md §5.1 — 값 어휘는 코드 상수, CHECK 없음)
  deviceClass      String           @default("WEARABLE") @map("device_class")   // WEARABLE / GATEWAY / THIRD_PARTY
  onpremDeviceType Int?             @map("onprem_device_type")                  // 온프렘 코드 1 ECG·2 TEMP·3 SpO2·6 BP·8 TAG·10 RING·11 CHARM
  serialPattern    String?          @map("serial_pattern")                      // 경고용 정규식
  serialTracked    Boolean          @default(false) @map("serial_tracked")      // 원장 대상 모델의 단일 소스
  quantityTracked  Boolean          @default(true) @map("quantity_tracked")     // 프로젝트·딜 수량 폼 노출 여부
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  devices         ProjectDevice[]
  deviceUnits     DeviceUnit[]     // 시리얼 유닛(3층 구조 B-20, 2026-09-01) — 구 hospitalDevices(병원×모델 수량) 역관계 대체
  inventoryItems  InventoryItem[]
  salesDealDevices SalesDealDevice[]

  @@map("device_info")
  @@schema("public")
}

model Contractor {
  id           Int       @id @default(autoincrement())
  code         String    @unique @map("code")
  name         String    @map("name")
  bizRegNumber String?   @map("biz_reg_number")
  managerName  String?   @map("manager_name")
  managerPhone String?   @map("manager_phone")
  managerEmail String?   @map("manager_email")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  projects     Project[]

  @@map("constructors")
  @@schema("public")
}

model BuildStatus {
  id           Int           @id @default(autoincrement())
  label        String        @map("label")
  color        String?       @map("color")
  // 도메인↔티켓 상태 매핑 (ticket_status_map_design.md)
  ticketStatus TicketStatus? @map("ticket_status")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  projects  Project[]

  @@map("build_statuses")
  @@schema("public")
}

model Project {
  id                Int               @id @default(autoincrement())
  projectCode       String            @unique @map("project_code")
  projectName       String            @map("project_name")
  hospitalCode      String            @map("hospital_code")
  orderNumber       Int               @map("order_number")
  contractDate      DateTime?         @map("contract_date")
  contractType      String?           @map("contract_type")
  wardCount         Int?              @map("ward_count")
  bedCount          Int?              @map("bed_count")
  gatewayCount      Int?              @map("gateway_count")
  hasSurvey         Boolean           @default(false) @map("has_survey")
  hasOrder          Boolean           @default(false) @map("has_order")
  builderNameManual String?           @map("builder_name_manual")
  constructorId     Int?              @map("constructor_id")
  startDate         DateTime?         @map("start_date")
  endDateExpected   DateTime?         @map("end_date_expected")
  educationDate     DateTime?         @map("education_date") // 교육일 (영업/CRM v4 — 운영 축 귀속)
  buildStatusId     Int?              @map("build_status_id")
  statusChangedAt   DateTime?         @default(now()) @map("status_changed_at") // 현재 공사상태 진입 시각 (단계 체류 지연 감지)
  introTypeId       Int?              @map("intro_type_id")
  issueNote         String?           @map("issue_note") @db.Text
  remark            String?           @map("remark")
  driveFolderId     String?           @map("drive_folder_id")
  calendarEventId   String?           @map("calendar_event_id")
  ticketId          Int?              @unique @map("ticket_id") // P9 티켓 편입 — 1:1 연결
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  ticket            Ticket?           @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  hospital          Hospital          @relation(fields: [hospitalCode], references: [hospitalCode])
  contractor        Contractor?       @relation(fields: [constructorId], references: [id])
  buildStatus       BuildStatus?      @relation(fields: [buildStatusId], references: [id])
  introType         StatusCode?       @relation("ProjectIntroType", fields: [introTypeId], references: [id])
  devices           ProjectDevice[]
  files             ProjectFile[]
  assignees         ProjectAssignee[]
  salesDeal         SalesDeal?

  @@map("projects")
  @@schema("public")
}

model ProjectDevice {
  id           Int        @id @default(autoincrement())
  projectId    Int        @map("project_id")
  deviceInfoId Int        @map("device_info_id")
  quantity     Int        @default(0) @map("quantity")
  createdAt    DateTime   @default(now()) @map("created_at")
  project      Project    @relation(fields: [projectId], references: [id])
  deviceInfo   DeviceInfo @relation(fields: [deviceInfoId], references: [id])

  @@unique([projectId, deviceInfoId])
  @@map("project_devices")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// 병원별 웨어러블 디바이스 원장 (2026-09-01, projects/hospital_device_registry_design.md §5)
// CHECK·DEFERRABLE·부분 인덱스는 SQL(마이그 20260901120000_hospital_device_registry)이 단일 소스 — 모델 주석으로만 표기
// ─────────────────────────────────────────────────────────────────────────────

// 병원별 병동 마스터 (D4) — name_norm = normalizeWardName 결과(매칭·유니크 키)
// SQL-only: 부분 UNIQUE (hospital_code, ext_ward_code) WHERE ext_ward_code IS NOT NULL
model HospitalWard {
  id           Int                   @id @default(autoincrement())
  hospitalCode String                @map("hospital_code")
  name         String
  nameNorm     String                @map("name_norm")
  extWardCode  String?               @map("ext_ward_code")
  isActive     Boolean               @default(true) @map("is_active")
  sortOrder    Int                   @default(0) @map("sort_order")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at")
  hospital     Hospital              @relation(fields: [hospitalCode], references: [hospitalCode], onDelete: Restrict)
  devices      HospitalDevice[]      @relation("DeviceWard")
  eventsFrom   HospitalDeviceEvent[] @relation("EventFromWard")
  eventsTo     HospitalDeviceEvent[] @relation("EventToWard")

  @@unique([hospitalCode, nameNorm])
  @@unique([id, hospitalCode]) // 복합 FK 대상 (devices.ward / events.from_ward·to_ward)
  @@map("hospital_wards")
  @@schema("public")
}

// 시리얼 정체성(유닛) — 시리얼당 1행, 전역 UNIQUE (3층 구조 B-20: device_info → device_units → hospital_devices / inventory_units)
// API 공개 device id = device_units.id. source 어휘 MANUAL/IMPORT/WMS/ONPREM/BACKFILL는 코드 상수(CHECK 없음)
// SQL-only CHECK: serial_no <> '' AND serial_no = upper(btrim(serial_no)) (정규화 키 강제)
// SQL-only 인덱스: serial_no text_pattern_ops / 부분 (serial_raw) WHERE serial_raw IS NOT NULL
model DeviceUnit {
  id           Int                   @id @default(autoincrement())
  deviceInfoId Int                   @map("device_info_id")
  serialNo     String                @unique @map("serial_no")
  serialRaw    String?               @map("serial_raw")
  macAddress   String?               @map("mac_address")
  memo         String?
  source       String                @default("MANUAL")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at")
  deviceInfo   DeviceInfo            @relation(fields: [deviceInfoId], references: [id], onDelete: Restrict)
  placement    HospitalDevice?       @relation("UnitPlacement")      // 병원 배치 프로젝션 (유닛당 0..1행)
  replacedPlacements HospitalDevice[] @relation("DeviceReplacement") // 이 유닛이 교체기로 들어간 구기기 프로젝션들(replaced_by_id)
  events       HospitalDeviceEvent[] @relation("DeviceEvents")
  relatedEvents HospitalDeviceEvent[] @relation("EventRelatedDevice")

  @@index([deviceInfoId])
  @@map("device_units")
  @@schema("public")
}

// 병원 배치 프로젝션 — 유닛(DeviceUnit)당 0..1행(device_id UNIQUE). 상태 컬럼(status·hospital_code·ward_id…)은 이벤트 fold의 파생값 (D1/D3)
// 식별 속성(device_info_id·serial_no·serial_raw·mac_address·memo)은 DeviceUnit으로 이동 — 이 모델에는 없음
// SQL-only CHECK: status IN (ACTIVE, RECOVERED) / (status='ACTIVE') = (hospital_code IS NOT NULL) / ward_id IS NULL OR status='ACTIVE'
// SQL-only: 복합 FK (ward_id, hospital_code) → hospital_wards(id, hospital_code) DEFERRABLE INITIALLY DEFERRED
model HospitalDevice {
  id              Int                   @id @default(autoincrement())
  deviceId        Int                   @unique @map("device_id")
  extDeviceCode   String?               @map("ext_device_code")
  extLastSeenAt   DateTime?             @map("ext_last_seen_at")
  extSyncedAt     DateTime?             @map("ext_synced_at")
  status          String                @default("ACTIVE") // ACTIVE / RECOVERED
  hospitalCode    String?               @map("hospital_code")
  wardId          Int?                  @map("ward_id")
  placedOn        DateTime?             @map("placed_on") @db.Date
  lastHospitalCode String?              @map("last_hospital_code")
  recoveredOn     DateTime?             @map("recovered_on") @db.Date
  recoverReasonId Int?                  @map("recover_reason_id")
  lastEventType   String?               @map("last_event_type")
  lastEventOn     DateTime?             @map("last_event_on") @db.Date
  replacedById    Int?                  @map("replaced_by_id") // 교체기 유닛(device_units.id)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at")
  unit            DeviceUnit            @relation("UnitPlacement", fields: [deviceId], references: [id], onDelete: Restrict)
  hospital        Hospital?             @relation("DeviceCurrentHospital", fields: [hospitalCode], references: [hospitalCode], onDelete: Restrict)
  ward            HospitalWard?         @relation("DeviceWard", fields: [wardId, hospitalCode], references: [id, hospitalCode], onDelete: Restrict, map: "hospital_devices_ward_fkey")
  lastHospital    Hospital?             @relation("DeviceLastHospital", fields: [lastHospitalCode], references: [hospitalCode], onDelete: SetNull)
  recoverReason   StatusCode?           @relation("DeviceRecoverReason", fields: [recoverReasonId], references: [id], onDelete: Restrict)
  replacedBy      DeviceUnit?           @relation("DeviceReplacement", fields: [replacedById], references: [id], onDelete: SetNull)

  @@index([hospitalCode, status])
  @@index([wardId])
  @@index([lastHospitalCode, status])
  @@map("hospital_devices")
  @@schema("public")
}

// 임포트 배치 — 취소 단위 (D6). source_kind CHECK (EXCEL, PASTE)는 SQL-only; mode(REGISTER/ONPREM_DRAFT)는 코드 상수
model HospitalDeviceImportBatch {
  id                Int                   @id @default(autoincrement())
  hospitalCode      String                @map("hospital_code")
  sourceKind        String                @map("source_kind")
  mode              String                @default("REGISTER")
  fileName          String?               @map("file_name")
  occurredOn        DateTime              @map("occurred_on") @db.Date
  note              String?
  rowCount          Int                   @default(0) @map("row_count")
  registeredCount   Int                   @default(0) @map("registered_count")
  reregisteredCount Int                   @default(0) @map("reregistered_count")
  skippedCount      Int                   @default(0) @map("skipped_count")
  transferredCount  Int                   @default(0) @map("transferred_count")
  summary           Json?
  createdById       String?               @map("created_by")
  createdAt         DateTime              @default(now()) @map("created_at")
  cancelledAt       DateTime?             @map("cancelled_at")
  cancelledById     String?               @map("cancelled_by")
  cancelSummary     Json?                 @map("cancel_summary")
  hospital          Hospital              @relation(fields: [hospitalCode], references: [hospitalCode], onDelete: Restrict)
  createdBy         User?                 @relation("DeviceImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy       User?                 @relation("DeviceImportCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  events            HospitalDeviceEvent[]

  @@index([hospitalCode, createdAt(sort: Desc)], map: "hospital_device_import_batches_hospital_created_idx")
  @@map("hospital_device_import_batches")
  @@schema("public")
}

// 이벤트 이력 — append-first, 단일 소스 (§4.1). device_id·related_device_id는 유닛(DeviceUnit) 참조. event_type REGISTER/MOVE_WARD/RECOVER/CORRECT
// SQL-only CHECK: event_type 어휘 / CORRECT 외 hospital_code 필수 / 병동 있으면 hospital_code 필수 / RECOVER 사유 필수 / CORRECT changes 필수 / (ref_type IS NULL)=(ref_code IS NULL)
// SQL-only: 복합 FK (from_ward_id|to_ward_id, hospital_code) DEFERRABLE INITIALLY DEFERRED
// SQL-only 부분 인덱스: (ref_type, ref_code) / (import_batch_id) / (action_group) / 멱등 UNIQUE (ref_type, ref_code, device_id, event_type) WHERE source IN ('WMS','ONPREM')
model HospitalDeviceEvent {
  id              Int                        @id @default(autoincrement())
  deviceId        Int                        @map("device_id")
  eventType       String                     @map("event_type")
  hospitalCode    String?                    @map("hospital_code") // 사건 병원 비정규화 (D8)
  fromWardId      Int?                       @map("from_ward_id")
  toWardId        Int?                       @map("to_ward_id")
  reasonCodeId    Int?                       @map("reason_code_id")
  occurredOn      DateTime                   @map("occurred_on") @db.Date // 업무일자 (D7)
  memo            String?
  refType         String?                    @map("ref_type") // MAINTENANCE / VOC / INVENTORY_TX / ONPREM_SYNC (코드 상수)
  refCode         String?                    @map("ref_code")
  relatedDeviceId Int?                       @map("related_device_id")
  actionGroup     String?                    @map("action_group") @db.Uuid
  source          String                     @default("MANUAL") // MANUAL / IMPORT / WMS / ONPREM
  importBatchId   Int?                       @map("import_batch_id")
  changes         Json?
  actorId         String?                    @map("actor_id")
  actorName       String?                    @map("actor_name")
  editedAt        DateTime?                  @map("edited_at")
  editedById      String?                    @map("edited_by")
  createdAt       DateTime                   @default(now()) @map("created_at")
  device          DeviceUnit                 @relation("DeviceEvents", fields: [deviceId], references: [id], onDelete: Restrict)
  hospital        Hospital?                  @relation(fields: [hospitalCode], references: [hospitalCode], onDelete: Restrict)
  fromWard        HospitalWard?              @relation("EventFromWard", fields: [fromWardId, hospitalCode], references: [id, hospitalCode], onDelete: Restrict, map: "hospital_device_events_from_ward_fkey")
  toWard          HospitalWard?              @relation("EventToWard", fields: [toWardId, hospitalCode], references: [id, hospitalCode], onDelete: Restrict, map: "hospital_device_events_to_ward_fkey")
  reasonCode      StatusCode?                @relation("DeviceEventReason", fields: [reasonCodeId], references: [id], onDelete: Restrict)
  relatedDevice   DeviceUnit?                @relation("EventRelatedDevice", fields: [relatedDeviceId], references: [id], onDelete: SetNull)
  importBatch     HospitalDeviceImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  actor           User?                      @relation("DeviceEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  editedBy        User?                      @relation("DeviceEventEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([deviceId, occurredOn, id], map: "hospital_device_events_device_idx")
  @@index([hospitalCode, occurredOn(sort: Desc), id(sort: Desc)], map: "hospital_device_events_hospital_idx")
  @@index([eventType, occurredOn(sort: Desc)], map: "hospital_device_events_type_date_idx")
  @@map("hospital_device_events")
  @@schema("public")
}

