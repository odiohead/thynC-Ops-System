model AuditLog {
  id Int @id @default(autoincrement())

  actorId    String? @map("actor_id")
  actorEmail String? @map("actor_email")
  actorName  String? @map("actor_name")
  actorRole  String? @map("actor_role")

  action        String
  resource      String
  resourceId    String? @map("resource_id")
  resourceLabel String? @map("resource_label")

  before Json?
  after  Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([resource, resourceId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("public")
}

// ============================================================
// Wiki 모듈 (사내 위키)
//
// - 별도 PostgreSQL 스키마 `wiki`에 격리
// - FK 참조 방향: wiki.* → public.*  (반대 금지)
// - 코드 의존성: app/wiki/*, lib/wiki/* → 메인 OK / 메인 → 위키 금지
// ============================================================

model WikiPage {
  id           String   @id @default(uuid())
  parentId     String?  @map("parent_id")
  title        String
  slug         String?
  contentJson  Json     @map("content_json")
  isPublished  Boolean  @default(true) @map("is_published")
  sortOrder    Int      @default(0) @map("sort_order")
  authorId     String   @map("author_id")
  lastEditorId String?  @map("last_editor_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plainText      String    @default("") @map("plain_text")
  icon           String?   @map("icon")
  coverUrl       String?   @map("cover_url")
  coverOffsetY   Int       @default(50) @map("cover_offset_y")
  isTemplate     Boolean   @default(false) @map("is_template")
  deletedAt      DateTime? @map("deleted_at")
  collabEnabled  Boolean   @default(false) @map("collab_enabled")
  pageType       String    @default("block") @map("page_type") @db.VarChar(10)
  contentHtml    String?   @map("content_html")
  aiExcluded     Boolean   @default(false) @map("ai_excluded")
  /// 청크 인덱스를 마지막으로 재생성한 시각. `chunks_synced_at < updated_at`이면 재생성 대상.
  /// 갱신은 raw SQL로만 한다 — Prisma update를 쓰면 @updatedAt이 함께 올라 무한 재생성이 된다.
  chunksSyncedAt DateTime? @map("chunks_synced_at")

  parent        WikiPage?           @relation("WikiPageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      WikiPage[]          @relation("WikiPageTree")
  author        User                @relation("WikiPageAuthor", fields: [authorId], references: [id])
  lastEditor    User?               @relation("WikiPageLastEditor", fields: [lastEditorId], references: [id])
  attachments   WikiAttachment[]
  references    WikiPageReference[]
  tags          WikiPageTag[]
  favorites     WikiFavorite[]
  viewLogs      WikiViewLog[]
  versions      WikiVersion[]
  comments      WikiComment[]
  outgoingLinks WikiPageLink[]      @relation("WikiPageLinkSource")
  backlinks     WikiPageLink[]      @relation("WikiPageLinkTarget")
  ydoc          WikiPageYdoc?
  chunks        WikiChunk[]

  @@index([parentId, sortOrder])
  @@index([updatedAt(sort: Desc)])
  @@index([authorId])
  @@map("wiki_pages")
  @@schema("wiki")
}

/// 위키 청크 인덱스 (v3 W1) — 검색·반환 단위를 문서에서 헤딩 청크로 내린다.
/// 본문 저장 시 plainText 재계산과 같은 훅에서 재생성 (lib/wiki/chunk.ts)
/// 청크 인덱스 동기화 시각 — `chunks_synced_at < updated_at`이면 재생성 대상.
/// 본문 저장 주체가 협업 서버라 REST 훅만으로는 누락되므로 주기 스케줄러가 이 값으로 판정한다.
model WikiChunk {
  id          Int      @id @default(autoincrement())
  pageId      String   @map("page_id")
  ordinal     Int
  /// "3. 알람 정책 > 3.2 4단계 체계" — 랭킹 가중치이자 검색 결과 표시용
  headingPath String   @default("") @map("heading_path")
  text        String
  charStart   Int      @default(0) @map("char_start")
  charEnd     Int      @default(0) @map("char_end")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  page WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, ordinal])
  @@index([pageId])
  @@map("wiki_chunks")
  @@schema("wiki")
}

// 위키 실시간 동시편집(Yjs) 협업 문서 상태 — 편집 중 진실의 원천(Y.Doc 바이너리)
model WikiPageYdoc {
  pageId    String   @id @map("page_id")
  state     Bytes
  updatedAt DateTime @default(now()) @map("updated_at")

  page WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("wiki_page_ydoc")
  @@schema("wiki")
}

model WikiPageLink {
  sourcePageId String @map("source_page_id")
  targetPageId String @map("target_page_id")

  source WikiPage @relation("WikiPageLinkSource", fields: [sourcePageId], references: [id], onDelete: Cascade)
  target WikiPage @relation("WikiPageLinkTarget", fields: [targetPageId], references: [id], onDelete: Cascade)

  @@id([sourcePageId, targetPageId])
  @@index([targetPageId])
  @@map("wiki_page_links")
  @@schema("wiki")
}

model WikiNotification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  pageId    String?   @map("page_id")
  type      String
  actorId   String?   @map("actor_id")
  actorName String?   @map("actor_name")
  pageTitle String?   @map("page_title")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("wiki_notifications")
  @@schema("wiki")
}

model WikiAttachment {
  id         String   @id @default(uuid())
  pageId     String   @map("page_id")
  fileName   String   @map("file_name")
  s3Key      String   @unique @map("s3_key")
  size       Int
  mimeType   String   @map("mime_type")
  uploaderId String   @map("uploader_id")
  createdAt  DateTime @default(now()) @map("created_at")

  page     WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  uploader User     @relation("WikiAttachmentUploader", fields: [uploaderId], references: [id])

  @@index([pageId])
  @@map("wiki_attachments")
  @@schema("wiki")
}

model WikiPageReference {
  id          String   @id @default(uuid())
  pageId      String   @map("page_id")
  refType     String   @map("ref_type")
  refCode     String   @map("ref_code")
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy User     @relation("WikiPageRefCreator", fields: [createdById], references: [id])

  @@unique([pageId, refType, refCode])
  @@index([refType, refCode])
  @@index([pageId])
  @@map("wiki_page_references")
  @@schema("wiki")
}

model WikiTag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  pages WikiPageTag[]

  @@map("wiki_tags")
  @@schema("wiki")
}

model WikiPageTag {
  pageId  String   @map("page_id")
  tagId   String   @map("tag_id")
  addedAt DateTime @default(now()) @map("added_at")

  page WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tag  WikiTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([pageId, tagId])
  @@index([tagId])
  @@map("wiki_page_tags")
  @@schema("wiki")
}

model WikiFavorite {
  userId    String   @map("user_id")
  pageId    String   @map("page_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User     @relation("WikiFavoriteUser", fields: [userId], references: [id], onDelete: Cascade)
  page WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([userId, pageId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("wiki_favorites")
  @@schema("wiki")
}

model WikiViewLog {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  pageId   String   @map("page_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  user User     @relation("WikiViewLogUser", fields: [userId], references: [id], onDelete: Cascade)
  page WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt(sort: Desc)])
  @@index([pageId])
  @@map("wiki_view_logs")
  @@schema("wiki")
}

model WikiVersion {
  id          String   @id @default(uuid())
  pageId      String   @map("page_id")
  title       String
  contentJson Json     @map("content_json")
  savedById   String   @map("saved_by_id")
  savedAt     DateTime @default(now()) @map("saved_at")

  page    WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  savedBy User     @relation("WikiVersionSaver", fields: [savedById], references: [id])

  @@index([pageId, savedAt(sort: Desc)])
  @@map("wiki_versions")
  @@schema("wiki")
}

model WikiComment {
  id        String   @id @default(uuid())
  pageId    String   @map("page_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page   WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author User     @relation("WikiCommentAuthor", fields: [authorId], references: [id])

  @@index([pageId, createdAt])
  @@index([authorId])
  @@map("wiki_comments")
  @@schema("wiki")
}

// ===== 차량예약 =====

model Vehicle {
  id           Int      @id @default(autoincrement())
  name         String
  plateNumber  String   @unique @map("plate_number")
  model        String?
  seatCount    Int?     @map("seat_count")
  color        String?
  memo         String?
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  lastOdometer Int?     @map("last_odometer")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  reservations VehicleReservation[]
  logs         VehicleLog[]

  @@map("vehicles")
  @@schema("public")
}

model VehicleReservation {
  id          Int       @id @default(autoincrement())
  vehicleId   Int       @map("vehicle_id")
  userId      String    @map("user_id")
  startAt     DateTime  @map("start_at")
  endAt       DateTime  @map("end_at")
  purpose     String?
  destination String?
  status      String    @default("RESERVED")
  returnedAt  DateTime? @map("returned_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id])
  user    User        @relation("VehicleReservationUser", fields: [userId], references: [id])
  log     VehicleLog?

  @@index([vehicleId, startAt])
  @@index([userId, startAt])
  @@map("vehicle_reservations")
  @@schema("public")
}

model VehicleLog {
  id            Int      @id @default(autoincrement())
  vehicleId     Int      @map("vehicle_id")
  reservationId Int?     @unique @map("reservation_id")
  driverId      String   @map("driver_id")
  startAt       DateTime @map("start_at")
  endAt         DateTime @map("end_at")
  purpose       String?
  destination   String?
  endOdometer   Int      @map("end_odometer")
  distanceKm    Int?     @map("distance_km")
  note          String?
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vehicle     Vehicle             @relation(fields: [vehicleId], references: [id])
  reservation VehicleReservation? @relation(fields: [reservationId], references: [id])
  driver      User                @relation("VehicleLogDriver", fields: [driverId], references: [id])
  createdBy   User                @relation("VehicleLogCreator", fields: [createdById], references: [id])

  @@index([vehicleId, endAt])
  @@index([driverId, startAt])
  @@map("vehicle_logs")
  @@schema("public")
}

// ===== AI 어시스턴트 v2 (function_ai_assistant.html) =====

// 게이트웨이 배치 플래너 잡 (function_gateway_planner.html Phase 1)
model GatewayPlanJob {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(300)
  status        String   @default("PENDING") @db.VarChar(20) // PENDING|RASTERIZING|ANALYZING|NEED_SCALE|PLACED|ERROR
  originalKey   String   @map("original_key")
  originalName  String   @map("original_name") @db.VarChar(300)
  pageIndex     Int      @default(0) @map("page_index")
  pageCount     Int?     @map("page_count")
  imageKey      String?  @map("image_key") // 원본 해상도 PNG (PPTX 배경용)
  visionKey     String?  @map("vision_key") // 분석·미리보기용 축소 PNG (좌표 기준)
  imageWidth    Int?     @map("image_width")
  imageHeight   Int?     @map("image_height")
  visionWidth   Int?     @map("vision_width")
  visionHeight  Int?     @map("vision_height")
  scaleMPerPx   Float?   @map("scale_m_per_px") // 확정 스케일 (m / vision px)
  scaleSource   String?  @map("scale_source") @db.VarChar(20) // ai_dimension | manual_2point | none
  scaleMeta     Json?    @map("scale_meta") // AI 치수 후보·산포 등
  analysis      Json? // 공간 인식 결과 (spaces[], vision 좌표)
  placements    Json? // 배치 결과 (points[], vision 좌표)
  gatewayCount  Int?     @map("gateway_count")
  rulesSnapshot Json?    @map("rules_snapshot")
  pptxKey       String?  @map("pptx_key")
  errorMessage  String?  @map("error_message")
  tokenUsage    Json?    @map("token_usage")
  createdById   String   @map("created_by")
  createdBy     User     @relation("GatewayPlanJobCreator", fields: [createdById], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([createdById, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("gateway_plan_jobs")
  @@schema("public")
}

model AiChatSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  hospitalCode String?  @map("hospital_code")
  title        String   @default("") @db.VarChar(80)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital?       @relation(fields: [hospitalCode], references: [hospitalCode])
  messages AiChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("ai_chat_sessions")
  @@schema("public")
}

model AiChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      String   @db.VarChar(10)
  content   String   @default("")
  toolCalls Json?    @map("tool_calls")
  usage     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("ai_chat_messages")
  @@schema("public")
}

// AI 어시스턴트 사용량 원장 — 대화(세션/메시지) 삭제와 무관하게 사용량 집계 보존
// 계정 삭제 대비 이름·이메일 스냅샷, session/message는 FK 없이 ID만 보관
model AiUsageLog {
  id               Int      @id @default(autoincrement())
  userId           String?  @map("user_id")
  userName         String   @default("") @map("user_name") @db.VarChar(100)
  userEmail        String   @default("") @map("user_email") @db.VarChar(255)
  sessionId        String?  @map("session_id") @db.Uuid
  messageId        String?  @unique @map("message_id") @db.Uuid
  hospitalCode     String?  @map("hospital_code")
  model            String   @default("") @db.VarChar(50)
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  hospital Hospital? @relation(fields: [hospitalCode], references: [hospitalCode], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage_logs")
  @@schema("public")
}

/// AI 어시스턴트 답변 피드백 (v3 G2)
/// ai_usage_logs와 같은 이유로 메시지/세션에 FK를 걸지 않는다 — 대화를 삭제해도 피드백은 남아야
/// "무엇이 틀렸는가"의 근거가 보존된다. 답변의 toolCalls와 messageId로 조인해 실패 축·도구를 사후 분류한다.
model AiFeedback {
  id        Int      @id @default(autoincrement())
  messageId String   @unique @map("message_id") @db.Uuid
  sessionId String?  @map("session_id") @db.Uuid
  userId    String?  @map("user_id")
  userName  String   @default("") @map("user_name") @db.VarChar(100)
  /// good | bad
  verdict   String   @db.VarChar(10)
  /// bad일 때만 — wrong(틀림) | not_found(못 찾음) | outdated(오래된 정보) | inappropriate(부적절)
  reason    String?  @db.VarChar(20)
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([verdict, reason])
  @@map("ai_feedback")
  @@schema("public")
}

// ===== 티켓 시스템 (P1 — ticket_dev_schedule.md) =====

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED

  @@map("ticket_status")
  @@schema("public")
}

enum TicketSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
  SEV5

  @@map("ticket_severity")
  @@schema("public")
}

model TicketQueue {
  id              Int                   @id @default(autoincrement())
  name            String                @unique
  description     String?
  isActive        Boolean               @default(true) @map("is_active")
  sortOrder       Int                   @default(0) @map("sort_order")
  notifyChannelId Int?                  @map("notify_channel_id") // 그룹 알림 채널 (알림 v2 P2 — 할당·배정 알림 발송처)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  notifyChannel   NotifyChannel?        @relation("QueueNotifyChannel", fields: [notifyChannelId], references: [id], onDelete: SetNull)
  tickets         Ticket[]
  ctiDefaults     TicketCti[]           @relation("CtiDefaultQueue")
  members         TicketQueueMember[]
  domainRules     TicketDomainCtiRule[] @relation("CtiRuleQueue")

  @@map("ticket_queues")
  @@schema("public")
}

model TicketQueueMember {
  id        Int         @id @default(autoincrement())
  queueId   Int         @map("queue_id")
  userId    String      @map("user_id")
  createdAt DateTime    @default(now()) @map("created_at")
  queue     TicketQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user      User        @relation("TicketQueueMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queueId, userId])
  @@index([userId])
  @@map("ticket_queue_members")
  @@schema("public")
}

model TicketCti {
  id             Int                   @id @default(autoincrement())
  parentId       Int?                  @map("parent_id")
  level          Int                   @db.SmallInt
  name           String
  defaultQueueId Int?                  @map("default_queue_id")
  isActive       Boolean               @default(true) @map("is_active")
  sortOrder      Int                   @default(0) @map("sort_order")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  parent         TicketCti?            @relation("CtiHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       TicketCti[]           @relation("CtiHierarchy")
  defaultQueue   TicketQueue?          @relation("CtiDefaultQueue", fields: [defaultQueueId], references: [id], onDelete: SetNull)
  tickets        Ticket[]
  domainRules    TicketDomainCtiRule[] @relation("CtiRuleCti")

  @@unique([parentId, name])
  @@index([parentId, sortOrder])
  @@map("ticket_cti")
  @@schema("public")
}

/// 도메인 업무 → 티켓 자동생성 시 붙는 CTI·Assignment Group·설명 자동입력 규칙 (ticket_cti_rule_design.md)
/// 해석 순서: (refType, matchStatusCodeId) 일치 → (refType, NULL) 기본 → 없으면 코드 폴백
model TicketDomainCtiRule {
  id                Int          @id @default(autoincrement())
  refType           String       @map("ref_type") // SITE_VISIT | INSTALL_PLAN | PROJECT | ETC | MAINTENANCE
  matchStatusCodeId Int?         @map("match_status_code_id") // 유지보수 장애유형별. NULL=업무 기본 규칙
  ctiId             Int          @map("cti_id")
  queueId           Int?         @map("queue_id") // NULL=CTI 기본 그룹 → 그것도 없으면 코드 폴백
  fillDescription   Boolean      @default(true) @map("fill_description")
  isActive          Boolean      @default(true) @map("is_active")
  updatedBy         String?      @map("updated_by")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  matchStatusCode   StatusCode?  @relation("CtiRuleMatchStatus", fields: [matchStatusCodeId], references: [id], onDelete: Cascade)
  cti               TicketCti    @relation("CtiRuleCti", fields: [ctiId], references: [id], onDelete: Restrict)
  queue             TicketQueue? @relation("CtiRuleQueue", fields: [queueId], references: [id], onDelete: SetNull)
  updater           User?        @relation("CtiRuleUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([refType, matchStatusCodeId], map: "ticket_domain_cti_rules_scope_uniq")
  @@index([ctiId], map: "ticket_domain_cti_rules_cti_idx")
  @@index([refType], map: "ticket_domain_cti_rules_ref_idx")
  @@map("ticket_domain_cti_rules")
  @@schema("public")
}

/// VOC접수 — CS 사건의 원본 도메인 레코드. 연결 티켓(refType 'VOC')이 CS 마스터 티켓 (cs_ticket_workflow_design.md §5)
/// 도메인 어댑터: lib/ticket-domains/voc.ts — 어댑터 SOP(§3.4)의 첫 적용 사례
/// 담당 배정은 티켓이 단독 소유 (2026-08-15 개정 — 도메인에는 생성자만 기록, 담당자 N:M 제거)
model VocReceipt {
  id              Int       @id @default(autoincrement())
  vocCode         String    @unique @map("voc_code") @db.VarChar(20) // VOC-YYYYMM-NNNN
  hospitalCode    String?   @map("hospital_code") // 비고객 VOC 허용
  hospitalNameRaw String?   @map("hospital_name_raw")
  customerName    String?   @map("customer_name") // 고객(제기자)
  customerPhone   String?   @map("customer_phone")
  channelId       Int?      @map("channel_id") // 접수 채널 — StatusCode VOC_CHANNEL (콜 승격 시 '전화')
  vocTypeId       Int?      @map("voc_type_id") // VOC 분류 — StatusCode VOC_TYPE (자동생성 규칙 조건 축)
  statusId        Int?      @map("status_id") // 워크플로 상태 — StatusCode VOC_STATUS (+ticket_status 매핑 필수)
  statusChangedAt DateTime? @default(now()) @map("status_changed_at") // 현재 상태 진입 시각
  title           String    @map("title")
  content         String?   @map("content") @db.Text
  resolution      String?   @map("resolution") @db.Text // 처리 결과 요약 (Tiptap — 유지보수 resolution 선례)
  receivedAt      DateTime  @default(now()) @map("received_at")
  resolvedAt      DateTime? @map("resolved_at") @db.Date
  createdById     String?   @map("created_by_id") // 생성자 — 배정이 아니라 기록 (계정 삭제 시 NULL)
  ticketId        Int?      @unique @map("ticket_id") // 도메인 1:1 연결 — CS 마스터 티켓
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  hospital  Hospital?   @relation(fields: [hospitalCode], references: [hospitalCode], onDelete: SetNull)
  channel   StatusCode? @relation("VocChannel", fields: [channelId], references: [id], onDelete: SetNull)
  vocType   StatusCode? @relation("VocType", fields: [vocTypeId], references: [id], onDelete: SetNull)
  status    StatusCode? @relation("VocStatus", fields: [statusId], references: [id], onDelete: SetNull)
  createdBy User?       @relation("VocCreator", fields: [createdById], references: [id], onDelete: SetNull)
  ticket    Ticket?     @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([receivedAt])
  @@index([hospitalCode])
  @@index([statusId])
  @@map("voc_receipts")
  @@schema("public")
}

model TicketPendingReason {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  tickets     Ticket[]
  statusCodes StatusCode[] @relation("StatusCodePendingReason")

  @@map("ticket_pending_reasons")
  @@schema("public")
}

model Ticket {
  id              Int                  @id @default(autoincrement())
  ticketCode      String               @unique @map("ticket_code")
  title           String
  descriptionHtml String?              @map("description_html")
  status          TicketStatus         @default(OPEN)
  severity        TicketSeverity       @default(SEV4)
  queueId         Int                  @map("queue_id")
  ctiId           Int?                 @map("cti_id")
  ownerId         String?              @map("owner_id")
  pendingReasonId Int?                 @map("pending_reason_id")
  pendingNote     String?              @map("pending_note")
  hospitalCode    String?              @map("hospital_code")
  parentId        Int?                 @map("parent_id")
  refType         String?              @map("ref_type") // 도메인 연결 유형 (MAINTENANCE 등, NULL=순수 티켓)
  statusChangedAt DateTime             @default(now()) @map("status_changed_at")
  resolvedAt      DateTime?            @map("resolved_at")
  closedAt        DateTime?            @map("closed_at")
  reopenCount     Int                  @default(0) @map("reopen_count")
  dueAt           DateTime?            @map("due_at")
  notifySig       String?              @map("notify_sig") // 알림 변경 감지 시그니처 (v2 P1 — lib/notify.ts 전용)
  createdBy       String?              @map("created_by")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  queue           TicketQueue          @relation(fields: [queueId], references: [id])
  cti             TicketCti?           @relation(fields: [ctiId], references: [id], onDelete: SetNull)
  owner           User?                @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  pendingReason   TicketPendingReason? @relation(fields: [pendingReasonId], references: [id], onDelete: SetNull)
  hospital        Hospital?            @relation(fields: [hospitalCode], references: [hospitalCode], onDelete: SetNull)
  creator         User?                @relation("TicketCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  participants    TicketParticipant[]
  logs            TicketLog[]
  slaClocks       TicketSlaClock[]
  parent          Ticket?              @relation("TicketHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Ticket[]             @relation("TicketHierarchy")
  maintenance     Maintenance?
  etcTask         EtcTask?
  siteVisit       SiteVisit?
  installPlan     InstallPlan?
  project         Project?
  voc             VocReceipt?

  @@index([queueId, status])
  @@index([parentId])
  @@index([refType])
  @@index([ownerId, status])
  @@index([severity])
  @@index([statusChangedAt])
  @@index([hospitalCode])
  @@map("tickets")
  @@schema("public")
}

model TicketParticipant {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation("TicketParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@map("ticket_participants")
  @@schema("public")
}

model TicketLog {
  id          Int      @id @default(autoincrement())
  ticketId    Int      @map("ticket_id")
  logType     String   @map("log_type")
  authorId    String?  @map("author_id")
  contentHtml String?  @map("content_html")
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User?    @relation("TicketLogAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_logs")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────
// SLA 시계 엔진 (1.1 P1 — projects/notification_v1.1_design.md §4)
// 정책(어떤 티켓에) × 타깃(무엇을 몇 분 안에) × 시계(티켓별 실측 인스턴스)
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// 시스템 내부 알림 (1.1 P5 — projects/notification_v1.1_design.md §6)
// 알림의 원본은 이 테이블이고 Slack은 어댑터. 향후 페이저 앱도 같은 소스를 쓴다
// ─────────────────────────────────────────────────────────────

/// 개인 알림함 — 사용자별 1행. 티켓은 FK 없이 ID만 보관(삭제 후에도 이력 보존)
model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    String    @map("user_id")
  kind      String    @db.VarChar(40) // NOTIFY_KINDS (lib/notify-center.ts)
  title     String    @db.VarChar(200)
  body      String?
  link      String    @db.VarChar(300) // 앱 내부 경로
  ticketId  Int?      @map("ticket_id")
  refType   String?   @map("ref_type") @db.VarChar(20)
  refCode   String?   @map("ref_code") @db.VarChar(50)
  severity  String?   @db.VarChar(10)
  actorId   String?   @map("actor_id")
  actorName String?   @map("actor_name") @db.VarChar(60) // 스냅샷
  dedupKey  String?   @map("dedup_key") @db.VarChar(200) // 부분 UNIQUE (SQL 전용 인덱스)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([ticketId])
  @@map("notifications")
  @@schema("public")
}

/// 개인 수신 설정 — 행이 없으면 코드 기본값(NOTIFY_KIND_DEFAULTS) 적용
model NotificationPref {
  userId  String  @map("user_id")
  kind    String  @db.VarChar(40)
  inApp   Boolean @default(true) @map("in_app")
  slackDm Boolean @default(false) @map("slack_dm")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
  @@map("notification_prefs")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────
// Slack 채널 라우팅 (1.1 P3 — projects/notification_v1.1_design.md §5.1)
// 채널을 env 상수에서 DB로. 이벤트×조건 → 채널 N개 (매칭된 규칙 전부 실행, 같은 채널은 1건으로 합침)
// ─────────────────────────────────────────────────────────────

/// 발송 채널 마스터 — Slack 채널 ID를 런타임에 등록·비활성
model NotifyChannel {
  id             Int           @id @default(autoincrement())
  name           String        @unique @db.VarChar(60)
  slackChannelId String        @map("slack_channel_id") @db.VarChar(40)
  description    String?
  isActive       Boolean       @default(true) @map("is_active")
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  routes         NotifyRoute[]
  queues         TicketQueue[] @relation("QueueNotifyChannel") // 그룹 알림 채널 역참조 (v2 P2)
  slaPolicies    SlaPolicy[]   @relation("SlaPolicyNotifyChannel") // 정책 알림 채널 역참조 (v2 P3)

  @@map("notify_channels")
  @@schema("public")
}

/// 라우팅 규칙 — 매칭 축은 SLA 정책과 동일 의미론(축 간 AND, 배열 내부 OR, 빈 배열=전체)
model NotifyRoute {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(100)
  eventType   String        @map("event_type") @db.VarChar(30) // TICKET_CREATED|TICKET_STATUS_CHANGED|TICKET_QUEUE_TRANSFERRED|SEV_ESCALATED|SLA_BREACH|SLA_WARNING|DAILY_DIGEST
  channelId   Int           @map("channel_id")
  refTypes    String[]      @default([]) @map("ref_types")
  queueIds    Int[]         @default([]) @map("queue_ids")
  ctiIds      Int[]         @default([]) @map("cti_ids")
  severities  String[]      @default([])
  statusTo    String[]      @default([]) @map("status_to") // 상태변경: 이 상태로 바뀔 때만
  metrics     String[]      @default([]) // SLA 이벤트: 대상 metric 한정
  mentionMode String        @default("none") @map("mention_mode") @db.VarChar(20) // none|queue_members|channel|here
  digestHour  Int?          @map("digest_hour") @db.SmallInt // DAILY_DIGEST 전용 (KST 0~23)
  digestOpts  Json?         @map("digest_opts")
  isActive    Boolean       @default(true) @map("is_active")
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  channel     NotifyChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([eventType, isActive])
  @@index([channelId])
  @@map("notify_routes")
  @@schema("public")
}

/// SLA 정책 — 매칭 스코프(빈 배열=전체) + 우선순위(낮을수록 우선, 1개만 승리)
model SlaPolicy {
  id          Int              @id @default(autoincrement())
  name        String           @db.VarChar(100)
  description String?
  priority    Int              @default(100)
  refTypes    String[]         @default([]) @map("ref_types")
  queueIds    Int[]            @default([]) @map("queue_ids")
  ctiIds      Int[]            @default([]) @map("cti_ids") // 서브트리 상속
  severities  String[]         @default([])
  clockType   String           @default("CALENDAR_24H") @map("clock_type") @db.VarChar(20) // CALENDAR_24H 단일 (v2 P1 — 달력시간 확정)
  notifyChannelId Int?          @map("notify_channel_id") // 정책별 SLA 초과 알림 채널 (v2 P3 — 없으면 SLA_BREACH 라우팅 폴백)
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  notifyChannel NotifyChannel? @relation("SlaPolicyNotifyChannel", fields: [notifyChannelId], references: [id], onDelete: SetNull)
  targets     SlaTarget[]
  clocks      TicketSlaClock[]

  @@index([isActive, priority])
  @@map("sla_policies")
  @@schema("public")
}

/// 정책별 목표 — metric×상태×Sev 조합당 1행. severity NULL = 정책 스코프 전 Sev 공통
model SlaTarget {
  id           Int              @id @default(autoincrement())
  policyId     Int              @map("policy_id")
  metric       String           @db.VarChar(20) // ASSIGN|FIRST_RESPONSE|RESOLVE|UPDATE_STALE|DWELL|DOMAIN_DUE
  statusScope  String?          @map("status_scope") @db.VarChar(20) // DWELL 전용(대상 상태)
  severity     String?          @db.VarChar(10)
  thresholdMin Int              @map("threshold_min") // 목표(분). DOMAIN_DUE는 기한 대비 오프셋
  warnRatio    Int              @default(80) @map("warn_ratio") @db.SmallInt // 목표의 N% 경과 시 임박(0=미사용)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  policy       SlaPolicy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  clocks       TicketSlaClock[]

  @@index([policyId])
  @@map("sla_targets")
  @@schema("public")
}

/// 티켓별 SLA 시계 — 알림·지표의 근거. 파생 데이터(삭제 후 재백필 가능)
/// UNIQUE (ticket_id, metric, COALESCE(status_scope,'')) 는 SQL 전용 인덱스로 관리
model TicketSlaClock {
  id               BigInt     @id @default(autoincrement())
  ticketId         Int        @map("ticket_id")
  metric           String     @db.VarChar(20)
  statusScope      String?    @map("status_scope") @db.VarChar(20)
  policyId         Int?       @map("policy_id")
  targetId         Int?       @map("target_id")
  thresholdMin     Int        @map("threshold_min")
  startedAt        DateTime   @map("started_at")
  dueAt            DateTime   @map("due_at")
  pausedAt         DateTime?  @map("paused_at")
  pausedMs         BigInt     @default(0) @map("paused_ms")
  state            String     @default("RUNNING") @db.VarChar(12) // RUNNING|PAUSED|MET|BREACHED|CANCELED
  satisfiedAt      DateTime?  @map("satisfied_at")
  breachedAt       DateTime?  @map("breached_at")
  notifiedWarnAt   DateTime?  @map("notified_warn_at")
  notifiedBreachAt DateTime?  @map("notified_breach_at") // 1회성 보장 · quiet backfill 마킹 겸용
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  ticket           Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  policy           SlaPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  target           SlaTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([state, metric])
  @@map("ticket_sla_clocks")
  @@schema("public")
}

// ─── 영업/CRM Phase 1+2 ─── (projects/sales_crm_design.md — 영업 정보 축, 열람은 SEERS+ADMIN 이상)

model HospitalSalesProfile {
  id             Int         @id @default(autoincrement())
  hospitalCode   String      @unique @map("hospital_code")
  stageId        Int?        @map("stage_id") // 영업 단계 (SALES_STAGE) — CRM 중심 축
  ownerId        String?     @map("owner_id") // 담당 영업 (씨어스 User)
  totalBeds      Int?        @map("total_beds") // 병원 전체(허가) 병상수 — 침투율 분모
  totalWards     Int?        @map("total_wards")
  salesMemo      String?     @map("sales_memo") @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  hospital       Hospital    @relation(fields: [hospitalCode], references: [hospitalCode], onDelete: Cascade)
  stage          StatusCode? @relation("SalesProfileStage", fields: [stageId], references: [id], onDelete: SetNull)
  owner          User?       @relation("SalesProfileOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@map("hospital_sales_profiles")
  @@schema("public")
}

model Person {
  id            Int                 @id @default(autoincrement())
  name          String              @map("name")
  personGroupId Int?                @map("person_group_id") // 직군 (PERSON_GROUP — 의사·간호·의공·전산·구매·원무·기타)
  specialty     String?             @map("specialty") // 진료과 (의사인 경우)
  phone         String?             @map("phone") // 개인 연락처 — 병원 이동해도 유지되므로 인물에 귀속
  email         String?             @map("email")
  memo          String?             @map("memo") @db.Text // 성향·관계 메모
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  personGroup   StatusCode?         @relation("PersonGroup", fields: [personGroupId], references: [id], onDelete: SetNull)
  affiliations  PersonAffiliation[]

  @@map("persons")
  @@schema("public")
}

model PersonAffiliation {
  id           Int       @id @default(autoincrement())
  personId     Int       @map("person_id")
  hospitalCode String    @map("hospital_code")
  title        String?   @map("title") // 그 병원에서의 직책
  department   String?   @map("department")
  isPrimary    Boolean   @default(false) @map("is_primary") // 그 병원의 주요 인물
  isCurrent    Boolean   @default(true) @map("is_current") // 전원·퇴직 시 false (이력 보존)
  startedOn    DateTime? @map("started_on") @db.Date
  endedOn      DateTime? @map("ended_on") @db.Date
  note         String?   @map("note")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  person       Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  hospital     Hospital  @relation(fields: [hospitalCode], references: [hospitalCode], onDelete: Cascade)

  @@index([hospitalCode, isCurrent])
  @@index([personId])
  @@map("person_affiliations")
  @@schema("public")
}

model SalesDeal {
  id                 Int         @id @default(autoincrement())
  dealCode           String      @unique @map("deal_code") // DEAL-YYYYMM-NNNN
  hospitalCode       String      @map("hospital_code")
  roundNo            Int         @map("round_no") // 병원 내 차수 (1,2,…N) — 갭 허용, 재부여 없음
  projectCode        String?     @unique @map("project_code") // 운영 프로젝트 연결 (선택, 1:1)
  statusId           Int?        @map("status_id") // 딜 상태 (SALES_DEAL_STATUS)
  hospitalModelId    Int?        @map("hospital_model_id") // 병원 관점 판매모델 (SALES_MODEL)
  seersModelId       Int?        @map("seers_model_id") // 씨어스 관점 판매방식 (SALES_MODEL 공용 마스터)
  wardsText          String?     @map("wards_text") // 도입병동 (IM, ICU… 콤마 다중)
  deptsText          String?     @map("depts_text") // 도입진료과
  wardCount          Int?        @map("ward_count") // 계약 시점 스냅샷 (운영 실측은 연결 프로젝트)
  bedCount           Int?        @map("bed_count")
  amountProduct      BigInt?     @map("amount_product") // 제품(구성품) 금액 (원)
  amountConstruction BigInt?     @map("amount_construction") // 공사비 (원) — '판매' 합계는 제품+공사 파생
  amountActual       BigInt?     @map("amount_actual") // 실판매액 (원) — 매출 집계 기준
  taxInvoiceId       Int?        @map("tax_invoice_id") // 세금계산서 발행 (SALES_TAX_INVOICE)
  settlementId       Int?        @map("settlement_id") // 정산 상태 (SALES_SETTLEMENT)
  contractDate       DateTime?   @map("contract_date") @db.Date
  productType        String      @default("일반") @map("product_type") // 상품유형 (일반/라이트)
  remark             String?     @map("remark") @db.Text
  warrantyText       String?     @map("warranty_text") // 보증기간 (구파일)
  firstContactDate   DateTime?   @map("first_contact_date") @db.Date // 최초 인입일 (구파일)
  // ── 대웅 축 (2026-07-31 — 원천: thynC_status_DW.xlsx 대웅 원장 + 구파일 보강. 씨어스 금액과 분리 관리) ──
  daewoongClientCode   String?   @map("daewoong_client_code") // 거래처코드 (DW 매핑 키)
  daewoongCountType    String?   @map("daewoong_count_type") // 카운팅 구분 (병원/추가/로컬/이슈)
  daewoongOrderStatus  String?   @map("daewoong_order_status") // 오더 구분 (완료/미완료)
  daewoongModelKind    String?   @map("daewoong_model_kind") // 판매모델 구분 (일반/사용량)
  daewoongModel        String?   @map("daewoong_model") // 판매모델 (구독형/구축형/분납형/사용량/씨어스 월 납입)
  daewoongDeviceCount  Int?      @map("daewoong_device_count") // 디바이스수
  daewoongAmountTotal  BigInt?   @map("daewoong_amount_total") // 계약금액(총견적가) 원
  daewoongBuildDate    DateTime? @map("daewoong_build_date") @db.Date // 공사일 (원장 정렬기준)
  daewoongAmountProduct      BigInt? @map("daewoong_amount_product") // 제품가 원 (구파일)
  daewoongAmountConstruction BigInt? @map("daewoong_amount_construction") // 공사비 원 (구파일)
  daewoongAmountActual       BigInt? @map("daewoong_amount_actual") // 실판매액 원 (구파일)
  daewoongAmountService      BigInt? @map("daewoong_amount_service") // 용역매출 원 (구파일)
  daewoongTaxInvoice   String?   @map("daewoong_tax_invoice") // 세금계산서 발행 (구파일 원문)
  daewoongSettlement   String?   @map("daewoong_settlement") // 정산 상태 (구파일 원문)
  daewoongPriceType    String?   @map("daewoong_price_type") // 판매가 유형 (구파일 — 기존/권장/최소판매가 등)
  daewoongDivision   String?     @map("daewoong_division") // 대웅 사업부
  daewoongOffice     String?     @map("daewoong_office") // 대웅 사무소
  daewoongManager    String?     @map("daewoong_manager") // 대웅 담당자
  daewoongPhone      String?     @map("daewoong_phone") // 대웅 담당자 연락처
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  hospital           Hospital    @relation(fields: [hospitalCode], references: [hospitalCode])
  project            Project?    @relation(fields: [projectCode], references: [projectCode], onDelete: SetNull)
  status             StatusCode? @relation("DealStatus", fields: [statusId], references: [id], onDelete: SetNull)
  hospitalModel      StatusCode? @relation("DealHospitalModel", fields: [hospitalModelId], references: [id], onDelete: SetNull)
  seersModel         StatusCode? @relation("DealSeersModel", fields: [seersModelId], references: [id], onDelete: SetNull)
  taxInvoice         StatusCode? @relation("DealTaxInvoice", fields: [taxInvoiceId], references: [id], onDelete: SetNull)
  settlement         StatusCode? @relation("DealSettlement", fields: [settlementId], references: [id], onDelete: SetNull)
  activities         SalesActivity[]
  devices            SalesDealDevice[]

  @@unique([hospitalCode, roundNo])
  @@index([hospitalCode])
  @@map("sales_deals")
  @@schema("public")
}

model SalesActivity {
  id             Int         @id @default(autoincrement())
  hospitalCode   String      @map("hospital_code")
  activityDate   DateTime    @map("activity_date") @db.Date // 활동일 (소급 기록 허용)
  activityTypeId Int?        @map("activity_type_id")
  content        String      @map("content") @db.Text // Tiptap HTML (저장 시 sanitize)
  authorId       String?     @map("author_id")
  dealId         Int?        @map("deal_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  hospital       Hospital    @relation(fields: [hospitalCode], references: [hospitalCode], onDelete: Cascade)
  activityType   StatusCode? @relation("SalesActivityType", fields: [activityTypeId], references: [id], onDelete: SetNull)
  author         User?       @relation("SalesActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  deal           SalesDeal?  @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([hospitalCode, activityDate(sort: Desc)])
  @@map("sales_activities")
  @@schema("public")
}

model SalesDealDevice {
  id           Int        @id @default(autoincrement())
  dealId       Int        @map("deal_id")
  deviceInfoId Int        @map("device_info_id")
  quantity     Int        @default(0) // 계약 스냅샷 수량 (운영 실측은 ProjectDevice) — 0은 행 미저장
  createdAt    DateTime   @default(now()) @map("created_at")
  deal         SalesDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  deviceInfo   DeviceInfo @relation(fields: [deviceInfoId], references: [id])

  @@unique([dealId, deviceInfoId])
  @@map("sales_deal_devices")
  @@schema("public")
}

/// 주간업무 관리 항목(안건) (2026-08-19) — 사업본부 주간 리뷰, projects/weekly_ops_design.md
/// kind·status·bizType 값은 lib/weekly.ts 코드 상수. 완료 여부의 단일 소스는 completedWeek (status는 진행/보류만)
model WeeklyItem {
  id            Int       @id @default(autoincrement())
  kind          String // 'BIZ'(사업 안건) | 'OPS'(운영 안건) | 'DEV'(개발 안건) — 2026-08-20 개정 (구 PROJECT/ISSUE)
  title         String
  detail        String?   @db.Text
  status        String    @default("진행") // '진행' | '보류'
  bizType       String    @default("공통") @map("biz_type") // 'thynC' | 'mobiCARE' | '공통'
  hospitalCode  String?   @map("hospital_code")
  ownerTeamId   Int?      @map("owner_team_id") // 담당 팀 (departments)
  ownerId       String?   @map("owner_id")
  targetDate    DateTime? @map("target_date") @db.Date
  completedWeek DateTime? @map("completed_week") @db.Date // 완료 주차(월요일) — NULL이면 미완료
  completedAt   DateTime? @map("completed_at")
  sortOrder     Int       @default(0) @map("sort_order")
  createdById   String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  hospital  Hospital?   @relation(fields: [hospitalCode], references: [hospitalCode], onDelete: SetNull)
  ownerTeam Department? @relation(fields: [ownerTeamId], references: [id], onDelete: SetNull)
  owner     User?       @relation("WeeklyItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User?       @relation("WeeklyItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updates   WeeklyItemUpdate[]

  @@index([kind])
  @@index([hospitalCode])
  @@index([status])
  @@map("weekly_items")
  @@schema("public")
}

/// 주간업무 항목 × 주차별 진행 기록 — (item, week) 당 1건 upsert
model WeeklyItemUpdate {
  id          Int      @id @default(autoincrement())
  itemId      Int      @map("item_id")
  weekStart   DateTime @map("week_start") @db.Date // 주차 키(월요일)
  content     String   @db.Text
  updatedById String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  item      WeeklyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  updatedBy User?      @relation("WeeklyUpdateEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([itemId, weekStart])
  @@index([weekStart])
  @@map("weekly_item_updates")
  @@schema("public")
}

/// 주간 특이사항 — 주차별 N건 자유 기재 엔트리 (2026-08-19 보드 전환 — 구 주차당 1건 리뷰 메모)
model WeeklyWeekNote {
  id          Int      @id @default(autoincrement())
  weekStart   DateTime @map("week_start") @db.Date
  content     String   @default("") @db.Text
  createdById String?  @map("created_by")
  updatedById String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User? @relation("WeeklyNoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("WeeklyNoteEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([weekStart])
  @@map("weekly_week_notes")
  @@schema("public")
}
