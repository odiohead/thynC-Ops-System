# thync-usage-agent 설정 — /etc/thync-usage-agent/agent.env
# 줄마다 KEY=VALUE. 값에 공백이나 특수문자가 있으면 큰따옴표로 감싼다.

# 이 파일은 참고용이다. 실제 설정(agent.env)은 install.sh 가 등록을 마치면서 만든다.

# 수신 주소와 키 (한 쌍 — 개발 서버와 운영 서버의 키는 서로 다르다)
#   키 = install.sh 가 등록 때 받은 이 서버 전용 키(tuk_…), 또는 사람이 발급한 병원 토큰(tua_…)
USAGE_ENDPOINT=https://ops.seersthync.com/api/usage-ingest/v1
USAGE_TOKEN=

# 이 서버의 이름 (병원 안에서 유일). 비우면 호스트명. 서버 키는 등록한 이름과 묶여 있어 바꾸면 접속이 거부된다
#USAGE_SERVER_ID=

# 제품 DB — 조회 전용 계정 (create-db-user.sql 로 만든다)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=thync
DB_USER=thync_usage_ro
DB_PASSWORD=

# 한 서버 DB 에 여러 병원의 기관이 있을 때만: 이 설정이 보낼 기관코드 (쉼표 구분). 비우면 전부
#ORG_INCLUDE=
# 제외할 기관코드 (기본값 REF_ORG — 템플릿 기관)
#ORG_EXCLUDE=REF_ORG

# 기기 상태 이력: 1회 전송 행 수 / 1회 실행당 전송 횟수 상한
#STATUS_BATCH_ROWS=5000
#STATUS_MAX_BATCHES=40
